{
  "cli": {
    "version": ">= 16.0.0",
    "requireCommit": false,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium"
      },
      "env": {
        "EVENT": "uoa-2026",
        "EXPO_PUBLIC_DOMAIN": "expo-conference-hub.replit.app"
      }
    },
    "uoa-2026": {
      "extends": "production"
    },
    "sample-event": {
      "extends": "production",
      "env": {
        "EVENT": "sample-event",
        "EXPO_PUBLIC_DOMAIN": "expo-conference-hub.replit.app"
      }
    },
    "sample-event-preview": {
      "extends": "preview",
      "env": {
        "EVENT": "sample-event",
        "EXPO_PUBLIC_DOMAIN": "expo-conference-hub.replit.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6762055147"
      },
      "android": {
        "track": "internal"
      }
    },
    "uoa-2026": {
      "extends": "production"
    },
    "sample-event": {
      "android": {
        "track": "internal"
      },
      "ios": {}
    }
  }
}
